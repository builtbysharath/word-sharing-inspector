{
  "name": "word-sharing-inspector",
  "version": "0.1.1",
  "description": "Inspect DOCX metadata, comments, tracked changes and hidden text locally. No document uploads.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "word-sharing-inspector": "bin/word-sharing-inspector.js"
  },
  "exports": "./src/inspect.js",
  "files": [
    "src",
    "bin",
    "public",
    "scripts",
    "web",
    "examples",
    "test",
    "docs",
    "README.md",
    "VALIDATION.md",
    "BENCHMARK.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build.js",
    "demo": "node scripts/make-demo.js",
    "start": "node scripts/serve.js",
    "prepack": "npm run build",
    "pack:browser": "node scripts/package-browser.js"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.11",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/builtbysharath/word-sharing-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/builtbysharath/word-sharing-inspector/issues"
  },
  "homepage": "https://builtbysharath.github.io/word-sharing-inspector/",
  "keywords": [
    "docx",
    "document-metadata",
    "microsoft-word",
    "tracked-changes",
    "hidden-text",
    "document-inspection",
    "privacy",
    "local-first"
  ]
}
